# Copy to .env.local (never commit real values). All optional.

# Run the engine with the offline scripted model (no API key needed).
RELAYIT_MOCK_MODEL=1

# Use the built-in fake Google (invented inbox + calendar) instead of a real account.
RELAYIT_FAKE_GOOGLE=1

# Your own Google OAuth client (type "Desktop app") for real Gmail/Calendar.
# You can also paste these in the app: Connections → Connect Google.
RELAYIT_GOOGLE_CLIENT_ID=
RELAYIT_GOOGLE_CLIENT_SECRET=

# Where the dev engine keeps its data (default: ./.relayit-dev).
# RELAYIT_DATA_DIR=

# Node binary the debug desktop build uses to run the engine (default: node on PATH).
# RELAYIT_NODE=

# Web UI → engine (only for `pnpm dev:ui` in a browser; the desktop app finds the engine itself).
VITE_CORE_URL=http://127.0.0.1:47821
VITE_CORE_TOKEN=dev
