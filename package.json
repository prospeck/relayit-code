{
  "name": "relayit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:core": "pnpm --filter @relayit/core dev",
    "dev:ui": "pnpm --filter @relayit/desktop dev:web",
    "tauri": "pnpm --filter @relayit/desktop tauri",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "fake-google": "pnpm --filter @relayit/connector-google fake",
    "test:ui": "pnpm --filter @relayit/e2e test",
    "dmg": "node scripts/make-dmg.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
